# ===========================================================================
# Variables del entorno Docker
#
#   cp .env.example .env
#   docker compose up -d
#
# Este archivo configura los CONTENEDORES. La configuración interna de Laravel
# vive en backend/.env (que el contenedor genera solo a partir de su propio
# .env.example); las variables definidas aquí tienen prioridad sobre aquellas.
# ===========================================================================

# Prefijo de los contenedores, volúmenes y redes.
COMPOSE_PROJECT_NAME=ejemplo

# ---------------------------------------------------------------------------
# Selección de entorno
# ---------------------------------------------------------------------------
# Desarrollo (por defecto): deja esta línea comentada.
# Producción (Droplet): descoméntala para que `docker compose up -d --build`
# use el archivo de producción sin tener que pasar -f a mano.
#
# COMPOSE_FILE=docker-compose.prod.yml

# ---------------------------------------------------------------------------
# Puertos publicados en el host
# ---------------------------------------------------------------------------
API_PORT=8000          # http://localhost:8000  -> API de Laravel (desarrollo)
FRONTEND_PORT=4200     # http://localhost:4200  -> Angular (desarrollo)
DB_PORT_HOST=5432      # PostgreSQL (desarrollo; en producción no se expone)
HTTP_PORT=80           # Puerto público en producción

# ---------------------------------------------------------------------------
# Base de datos PostgreSQL
# ---------------------------------------------------------------------------
DB_DATABASE=ejemplo
DB_USERNAME=ejemplo
# ¡CÁMBIALA en producción!
DB_PASSWORD=secret

# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------
APP_NAME=Ejemplo

# Desarrollo: el dev-server de Angular hace de proxy de /api hacia el backend,
# así que el navegador siempre ve un único origen (http://localhost:4200).
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4200

# En producción ambos se sirven desde el mismo Nginx:
#   APP_URL=https://tu-dominio.com
#   FRONTEND_URL=https://tu-dominio.com

# Obligatorio en producción. Genérala con:
#   docker compose run --rm app php artisan key:generate --show
APP_KEY=

LOG_LEVEL=debug

# Ejecutar migraciones al arrancar el contenedor.
# Cómodo en desarrollo; en producción es preferible lanzarlas a mano tras el deploy.
AUTO_MIGRATE=true

# ---------------------------------------------------------------------------
# Permisos de los bind mounts (solo Linux/macOS; en Windows se ignora)
# ---------------------------------------------------------------------------
# Consulta tus valores con: id -u  /  id -g
UID=1000
GID=1000
