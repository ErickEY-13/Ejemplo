# ===========================================================================
# Configuración de Laravel
#
# El entrypoint del contenedor copia este archivo a `.env` la primera vez.
# En Docker, las variables definidas en docker-compose tienen prioridad sobre
# las de aquí, así que normalmente no hace falta editarlo para desarrollar.
# ===========================================================================

APP_NAME="Ejemplo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Origen del SPA de Angular (se usa para las cabeceras CORS en desarrollo)
FRONTEND_URL=http://localhost:4200
# Lista separada por comas si hay más de un origen permitido
# CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------- PostgreSQL
# `db` es el nombre del servicio en docker-compose.yml
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ejemplo
DB_USERNAME=ejemplo
DB_PASSWORD=secret

# ---------------------------------------------------- Sesión, caché y colas
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ------------------------------------------------------------------ Correo
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
